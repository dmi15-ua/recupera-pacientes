# --- Básico ---
PUBLIC_BASE_URL=https://tu-dominio.com

# --- Base de datos ---
# Cualquier Postgres:
#  - Railway: en el servicio de la app, DATABASE_URL=${{Postgres.DATABASE_URL}} (red interna).
#    Desde tu ordenador usa DATABASE_PUBLIC_URL (host *.proxy.rlwy.net).
#  - Supabase: Connect -> URI, modo "Session pooler".
# Vacío = SQLite local en DATABASE_PATH (para desarrollar).
DATABASE_URL=
DB_SCHEMA=rp
DATABASE_PATH=data/app.db
# Opcional: clínicas iniciales. Solo se insertan si no existen; luego se editan en Supabase o /admin.
CLINICS_FILE=clinicas.json
# Token del dashboard /admin (y del simulador local). Genera uno: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- WhatsApp Cloud API (Meta) ---
# Vacío = modo simulación: los mensajes se imprimen en consola, no se envían.
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v23.0

# --- LLM ---
# Usa una key de un proyecto CON facturación (el nivel gratis puede usar los datos).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Telefonía ---
TWILIO_AUTH_TOKEN=
CALL_WEBHOOK_TOKEN=

# --- Avisos por Telegram (gratis) ---
TELEGRAM_BOT_TOKEN=
# Tu chat, para recibir los leads de la landing.
OWNER_TELEGRAM_CHAT_ID=

# --- Reglas (opcionales, en segundos) ---
# MISSED_CALL_DELAY_S=120
# DEBOUNCE_S=6
# HUMAN_TAKEOVER_S=43200
# MAX_LLM_CALLS_PER_DAY=20
# RETENTION_DAYS=180
# TRANSCRIBE_AUDIO=1
